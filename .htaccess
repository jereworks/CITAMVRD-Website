RewriteEngine On
RewriteBase /

# 1. Redirect /index or /index.html to the root homepage (https://valleyroad.citam.org/)
RewriteCond %{THE_REQUEST} ^GET\s.*/index(\.html)?\sHTTP [NC]
RewriteRule ^(.*)index(\.html)?$ / [R=301,L]

# 2. Externally redirect other .html URLs to clean URLs (e.g., /give.html -> /give)
RewriteCond %{THE_REQUEST} ^GET\s(.*)\.html\sHTTP [NC]
RewriteRule ^(.*)\.html$ $1 [R=301,L]

# Redirect trailing slash to non-trailing slash for .html pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ https://valleyroad.citam.org/$1 [R=301,L]

# 3. Internally serve the .html file when a clean URL is requested (e.g., /give -> /give.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Leverage Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
RewriteCond %{HTTP_HOST} ^valleyroad\.citam\.org$ [OR]
RewriteCond %{HTTP_HOST} ^www\.valleyroad\.citam\.org$
RewriteRule ^sermon$ "https\:\/\/valleyroad\.citam\.org\/sermons" [R=301,L]
RewriteCond %{HTTP_HOST} ^valleyroad\.citam\.org$ [OR]
RewriteCond %{HTTP_HOST} ^www\.valleyroad\.citam\.org$
RewriteRule ^live\-service\-today$ "https\:\/\/valleyroad\.citam\.org\/sermons" [R=301,L]
RewriteCond %{HTTP_HOST} ^valleyroad\.citam\.org$ [OR]
RewriteCond %{HTTP_HOST} ^www\.valleyroad\.citam\.org$
RewriteRule ^our\-history$ "https\:\/\/valleyroad\.citam\.org\/about" [R=301,L]
RewriteCond %{HTTP_HOST} ^valleyroad\.citam\.org$ [OR]
RewriteCond %{HTTP_HOST} ^www\.valleyroad\.citam\.org$
RewriteRule ^mission\-vision$ "https\:\/\/valleyroad\.citam\.org\/about" [R=301,L]
RewriteCond %{HTTP_HOST} ^valleyroad\.citam\.org$ [OR]
RewriteCond %{HTTP_HOST} ^www\.valleyroad\.citam\.org$
RewriteRule ^pastoral\-team$ "https\:\/\/valleyroad\.citam\.org\/about" [R=301,L]
RewriteCond %{HTTP_HOST} ^valleyroad\.citam\.org$ [OR]
RewriteCond %{HTTP_HOST} ^www\.valleyroad\.citam\.org$
RewriteRule ^contact\-us\-2$ "https\:\/\/valleyroad\.citam\.org\/contact" [R=301,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit